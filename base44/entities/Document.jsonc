{
  "name": "Document",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Document display name"
    },
    "doc_type": {
      "type": "string",
      "enum": [
        "Lease Agreement",
        "ID Proof",
        "Utility Bill",
        "Inspection Report",
        "Insurance",
        "Other"
      ],
      "default": "Other"
    },
    "file_url": {
      "type": "string",
      "description": "Uploaded file URL"
    },
    "linked_to": {
      "type": "string",
      "enum": [
        "house",
        "tenant"
      ],
      "description": "Whether linked to a house or tenant"
    },
    "house_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "linked_to"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}